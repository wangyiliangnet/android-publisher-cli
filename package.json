{
  "name": "android-publisher-cli",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyiliangnet/android-publisher-cli.git"
  },
  "homepage": "https://github.com/wangyiliangnet/android-publisher-cli#readme",
  "bugs": "https://github.com/wangyiliangnet/android-publisher-cli/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "build",
    "docs",
    ".node-version",
    "README.md",
    "CONTRIBUTING.md",
    "GLOSSARY.md",
    "AGENTS.md",
    "LICENSE",
    "LICENSE.zh-CN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "android-release": "./build/cli.js"
  },
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm run check && npm pack --dry-run --json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
